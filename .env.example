APP_VERSION=1.0.0
API_PREFIX=/api/v1
# Clave compartida con Laravel (cabecera X-API-Key). Vacia = sin autenticacion.
API_KEY=

# Carpeta del modelo exportado desde Colab. Tambien acepta el .zip
# con el mismo nombre (models/fme-layoutlmv3-funsd.zip), que se
# descomprime automaticamente al iniciar.
MODEL_DIR=models/fme-layoutlmv3-funsd
MODEL_DEVICE=cpu

# Idiomas instalados en Tesseract y ruta del ejecutable si no esta en PATH.
OCR_LANGUAGES=spa+eng
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# Carpeta de idiomas propia (opcional); vacia = la de Tesseract.
TESSDATA_DIR=models/tessdata

MAX_UPLOAD_MB=10
MIN_PASSING_SCORE=60
